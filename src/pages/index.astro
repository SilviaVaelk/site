---
import Base from '../layouts/Base.astro';
import { getProjects } from '../lib/projects';
import { url } from '../lib/url';

// Every project with `marble.show: true` becomes a marble.
const projects = await getProjects();
const items = projects
  .filter((p) => p.data.marble?.show)
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    href: url(`/work/${p.id}`),
    marble: p.data.marble,
  }));
---

<Base bare>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@800&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <!-- Project name, huge, behind the marbles -->
  <div class="bg-title" aria-live="polite"><span data-title></span></div>
  <canvas id="marbles" aria-hidden="true"></canvas>

  <!-- Same links as plain HTML, for screen readers and search engines -->
  <ul class="visually-hidden">
    {items.map((i) => <li><a href={i.href}>{i.title}</a></li>)}
  </ul>

  <script is:inline type="application/json" id="marble-data" set:html={JSON.stringify(items)} />
  <script is:inline type="application/json" id="marble-base" set:html={JSON.stringify(url('/marbles/'))} />
</Base>

<script>
  import { createMarbleScene } from '../marbles/scene.js';

  const items = JSON.parse(document.getElementById('marble-data')!.textContent!);
  const assetBase = JSON.parse(document.getElementById('marble-base')!.textContent!);
  const box = document.querySelector<HTMLElement>('.bg-title')!;
  const title = document.querySelector<HTMLElement>('[data-title]')!;

  // Make the name as big as fits the screen
  function fit() {
    if (!title.textContent) return;
    const maxH = window.innerHeight * 0.8;
    let size = Math.min(window.innerHeight * 0.5, window.innerWidth * 0.3);
    title.style.fontSize = `${size}px`;
    for (let i = 0; i < 40 && (title.scrollWidth > title.clientWidth + 1 || title.offsetHeight > maxH); i++) {
      size *= 0.92;
      title.style.fontSize = `${size}px`;
    }
  }
  window.addEventListener('resize', fit);
  document.fonts?.ready.then(fit);

  createMarbleScene({
    canvas: document.getElementById('marbles') as HTMLCanvasElement,
    items,
    assetBase,
    onHover(item) {
      if (!item) return box.classList.remove('show');
      title.textContent = item.title;
      fit();
      box.classList.add('show');
    },
    onSelect(item) {
      window.location.href = item.href;
    },
    insets: { top: 72, bottom: 24 },
  });
</script>

<style>
  .bg-title {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .bg-title:global(.show) {
    opacity: 1;
  }
  .bg-title span {
    display: block;
    max-width: 94vw;
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 800;
    text-transform: uppercase;
    color: #000;
    text-align: center;
    line-height: 0.86;
    letter-spacing: -0.03em;
    text-wrap: balance;
    overflow-wrap: normal;
  }
  #marbles {
    position: fixed;
    inset: 0;
    z-index: 1;
    width: 100vw;
    height: 100dvh;
    display: block;
    touch-action: none;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>
