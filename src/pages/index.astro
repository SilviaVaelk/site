---
import Base from '../layouts/Base.astro';
import { getProjects } from '../lib/projects';
import { url } from '../lib/url';

// Every project with `marble.show: true` becomes a marble.
const projects = await getProjects();
const items = projects
  .filter((p) => p.data.marble?.show)
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    summary: p.data.summary,
    href: url(`/work/${p.id}`),
    marble: p.data.marble,
  }));
---

<Base bare>
  <canvas id="marbles" aria-hidden="true"></canvas>

  <div class="panel" aria-live="polite">
    <div class="panel-title" data-title>/</div>
    <div class="panel-text muted" data-text>Click on a marble — or <a href={url('/work')}>see all work</a></div>
  </div>

  <!-- Same links as plain HTML, for screen readers and search engines -->
  <ul class="visually-hidden">
    {items.map((i) => <li><a href={i.href}>{i.title}</a></li>)}
  </ul>

  <script is:inline type="application/json" id="marble-data" set:html={JSON.stringify(items)} />
  <script is:inline type="application/json" id="marble-base" set:html={JSON.stringify(url('/marbles/'))} />
</Base>

<script>
  import { createMarbleScene } from '../marbles/scene.js';

  const items = JSON.parse(document.getElementById('marble-data')!.textContent!);
  const assetBase = JSON.parse(document.getElementById('marble-base')!.textContent!);
  const title = document.querySelector<HTMLElement>('[data-title]')!;
  const text = document.querySelector<HTMLElement>('[data-text]')!;
  const initial = { title: title.innerHTML, text: text.innerHTML };
  const isTouch = matchMedia('(hover: none)').matches;

  createMarbleScene({
    canvas: document.getElementById('marbles') as HTMLCanvasElement,
    items,
    assetBase,
    onHover(item) {
      if (!item) {
        title.innerHTML = initial.title;
        text.innerHTML = initial.text;
        return;
      }
      title.textContent = `[${item.title}]`;
      text.textContent = item.summary || '';
      const open = document.createElement('a');
      open.href = item.href;
      open.textContent = isTouch ? 'Tap again to open →' : 'Open →';
      text.append(document.createElement('br'), open);
    },
    onSelect(item) {
      window.location.href = item.href;
    },
  });
</script>

<style>
  #marbles {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    display: block;
    touch-action: none;
  }
  .panel {
    position: fixed;
    left: var(--space);
    bottom: var(--space);
    z-index: 5;
    max-width: min(520px, calc(100vw - 2 * var(--space)));
    text-transform: uppercase;
    pointer-events: none;
  }
  .panel :global(a) {
    pointer-events: auto;
  }
  .panel-title {
    font-weight: 500;
    margin-bottom: 4px;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>
