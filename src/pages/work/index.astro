---
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/projects';
import { url, mediaUrl } from '../../lib/url';

const projects = await getProjects();
---

<Base title="Work">
  <h1>Work</h1>
  <ul class="grid">
    {projects.map((p) => (
      <li>
        <a href={url(`/work/${p.id}`)}>
          {p.data.cover && (
            <div class="thumb">
              <img src={mediaUrl(p.data.cover)} alt="" loading="lazy" />
            </div>
          )}
          <span class="title">{p.data.title}</span>
          {p.data.summary && <span class="muted summary">{p.data.summary}</span>}
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .grid {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 24px;
  }
  a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
  }
  .thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--line);
    border-radius: 6px;
    margin-bottom: 8px;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  a:hover .thumb img {
    transform: scale(1.03);
  }
  .title {
    text-transform: uppercase;
    font-weight: 500;
  }
  .summary {
    font-size: 13px;
  }
  @media (max-width: 600px) {
    .grid {
      gap: 24px 8px;
    }
    .summary {
      display: none;
    }
  }
</style>
