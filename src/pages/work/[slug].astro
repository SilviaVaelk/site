---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/projects';
import { url, mediaUrl } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      next: projects[(i + 1) % projects.length],
      children: project.data.children.map((id) => projects.find((p) => p.id === id)).filter(Boolean),
    },
  }));
}

const { project, next, children } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const isVideo = (src: string) => /\.(mp4|webm|mov)$/i.test(src);
---

<Base title={d.title} description={d.summary || undefined} image={d.cover}>
  <article>
    <header class="intro">
      <h1>{d.title}</h1>
      {d.year && <p class="muted">{d.year}</p>}
      <div class="body"><Content /></div>
      {d.summary && !project.body?.trim().replace(/<!--.*?-->/s, '') && <p>{d.summary}</p>}
      {d.links.length > 0 && (
        <ul class="links">
          {d.links.map((l) => (
            <li><a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a></li>
          ))}
        </ul>
      )}
      {d.tags.length > 0 && <ul class="tags">{d.tags.map((t) => <li>{t}</li>)}</ul>}
    </header>

    {children.length > 0 && (
      <ul class="children">
        {children.map((c) => (
          <li>
            <a href={url(`/work/${c!.id}`)}>
              <div class="thumb">{c!.data.cover && <img src={mediaUrl(c!.data.cover)} alt="" loading="lazy" />}</div>
              <span class="child-title">{c!.data.title}</span>
              {c!.data.summary && <span class="muted child-summary">{c!.data.summary}</span>}
            </a>
          </li>
        ))}
      </ul>
    )}

    <div class:list={['media', d.layout]}>
      {d.media.map((m) => (
        <figure>
          {isVideo(m.src) ? (
            <video src={mediaUrl(m.src)} autoplay muted loop playsinline />
          ) : (
            <img src={mediaUrl(m.src)} alt={m.alt} loading="lazy" decoding="async" />
          )}
          {m.caption && <figcaption class="muted">{m.caption}</figcaption>}
        </figure>
      ))}
    </div>

    <nav class="next">
      <a href={url('/work')}>← All work</a>
      <a href={url(`/work/${next.id}`)}>Next: {next.data.title} →</a>
    </nav>
  </article>
</Base>

<style>
  article {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .intro {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .intro p,
  .body :global(p) {
    margin: 0 0 12px;
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  figure {
    margin: 0;
  }
  figure img,
  figure video {
    width: 100%;
    border-radius: 6px;
  }
  figcaption {
    font-size: 12px;
    margin-top: 6px;
  }

  /* Masonry: images keep their shape and stack in columns */
  .media.masonry {
    columns: 3;
    column-gap: 16px;
  }
  .media.masonry figure {
    break-inside: avoid;
    margin-bottom: 16px;
  }

  /* Grid: 3 columns of even tiles, images cropped to squares */
  .media.grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  @media (max-width: 600px) {
    .media.grid {
      gap: 4px;
    }
    .media.grid img,
    .media.grid video {
      border-radius: 2px;
    }
    .media.masonry {
      column-gap: 4px;
    }
    .media.masonry figure {
      margin-bottom: 4px;
    }
  }
  .media.grid img,
  .media.grid video {
    aspect-ratio: 1;
    object-fit: cover;
  }

  .children {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px 16px;
  }
  .children a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
  }
  .thumb {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--line);
    border-radius: 6px;
    margin-bottom: 6px;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .children a:hover .thumb img {
    transform: scale(1.03);
  }
  .child-title {
    text-transform: uppercase;
    font-weight: 500;
  }
  .child-summary {
    font-size: 13px;
  }
  @media (max-width: 600px) {
    .children {
      gap: 20px 6px;
    }
    .child-summary {
      display: none;
    }
  }
  .next {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    padding-top: 16px;
    text-transform: uppercase;
  }
  .next a {
    text-decoration: none;
  }
</style>
