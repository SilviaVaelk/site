---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/projects';
import { url, mediaUrl } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const isVideo = (src: string) => /\.(mp4|webm|mov)$/i.test(src);
---

<Base title={d.title} description={d.summary || undefined} image={d.cover}>
  <article>
    <header class="intro">
      <h1>{d.title}</h1>
      {d.year && <p class="muted">{d.year}</p>}
      <div class="body"><Content /></div>
      {d.summary && !project.body?.trim().replace(/<!--.*?-->/s, '') && <p>{d.summary}</p>}
      {d.links.length > 0 && (
        <ul class="links">
          {d.links.map((l) => (
            <li><a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a></li>
          ))}
        </ul>
      )}
      {d.tags.length > 0 && <ul class="tags">{d.tags.map((t) => <li>{t}</li>)}</ul>}
    </header>

    <div class:list={['media', d.layout]}>
      {d.media.map((m) => (
        <figure>
          {isVideo(m.src) ? (
            <video src={mediaUrl(m.src)} autoplay muted loop playsinline />
          ) : (
            <img src={mediaUrl(m.src)} alt={m.alt} loading="lazy" decoding="async" />
          )}
          {m.caption && <figcaption class="muted">{m.caption}</figcaption>}
        </figure>
      ))}
    </div>

    <nav class="next">
      <a href={url('/work')}>← All work</a>
      <a href={url(`/work/${next.id}`)}>Next: {next.data.title} →</a>
    </nav>
  </article>
</Base>

<style>
  article {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .intro {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .intro p,
  .body :global(p) {
    margin: 0 0 12px;
  }
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  figure {
    margin: 0;
  }
  figure img,
  figure video {
    width: 100%;
    border-radius: 6px;
  }
  figcaption {
    font-size: 12px;
    margin-top: 6px;
  }

  /* Masonry: images keep their shape and stack in columns */
  .media.masonry {
    columns: 3 280px;
    column-gap: 16px;
  }
  .media.masonry figure {
    break-inside: avoid;
    margin-bottom: 16px;
  }

  /* Grid: even tiles, images cropped to squares */
  .media.grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .media.grid img,
  .media.grid video {
    aspect-ratio: 1;
    object-fit: cover;
  }

  .next {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    padding-top: 16px;
    text-transform: uppercase;
  }
  .next a {
    text-decoration: none;
  }
</style>
